# Copie ce fichier en ".env" (jamais commité, voir .gitignore) et renseigne
# tes propres valeurs. Aucune clé ci-dessous n'est réelle.

# Bot Telegram (BotFather) et identifiant du salon/canal où poster les alertes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nansen (smart money / découverte quality). Optionnel en profil "degen".
NANSEN_API_KEY=
BIRDEYE_API_KEY=

# GoPlus Security API (optionnel — fonctionne sans clé avec des limites plus basses).
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# RPC EVM / Solana. Vide = endpoint public par défaut (fortement rate-limité,
# voir data_sources/solana_rpc.py). Un RPC privé (Helius, QuickNode...) est
# recommandé pour un scan Solana continu :
#   RPC_SOLANA=https://mainnet.helius-rpc.com/?api-key=TA_CLE
RPC_ROBINHOOD=
RPC_BSC=https://bsc-dataseed.binance.org
RPC_SOLANA=
